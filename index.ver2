
<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="theme-color" content="#111111">
<title>Gridder</title>
<style>
:root{color-scheme:dark;--bg:#101010;--panel:#1c1c1e;--line:#fff;--muted:#aaa;--accent:#ff3b70}
*{box-sizing:border-box}
html,body{margin:0;width:100%;height:100%;background:var(--bg);color:#fff;font-family:-apple-system,BlinkMacSystemFont,"Helvetica Neue",sans-serif;overscroll-behavior:none}
body{display:flex;flex-direction:column;padding:env(safe-area-inset-top) 14px env(safe-area-inset-bottom);gap:10px;overflow:hidden}
header{height:38px;display:flex;align-items:center;justify-content:space-between;flex:none}
.brand{font-size:21px;font-weight:800;letter-spacing:-.6px}
header small{font-size:11px;color:#888}
.topbar{display:flex;align-items:center;gap:8px}
select,button,input{font:inherit;color:inherit}
select,.tool,button{background:var(--panel);border:1px solid #333;border-radius:12px;padding:9px 11px}
select{font-size:13px;max-width:150px}
.iconbtn{width:38px;height:38px;padding:0;display:grid;place-items:center;font-size:19px;color:var(--accent)}
.export{font-size:12px;padding:9px 12px;background:#29292b}
.stage{min-height:0;flex:1;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden}
.canvas-wrap{position:relative;max-width:100%;max-height:100%;display:flex;align-items:center;justify-content:center}
#preview{display:block;max-width:100%;max-height:100%;width:auto;height:auto;object-fit:contain;background:#222;touch-action:none;border-radius:2px}
.hint{position:absolute;bottom:5px;left:0;right:0;text-align:center;color:#888;font-size:11px;pointer-events:none}
.controls{flex:none;background:var(--panel);border:1px solid #2c2c2e;border-radius:16px;padding:10px;display:flex;flex-direction:column;gap:9px}
.row{display:flex;align-items:center;gap:8px}
.row label{font-size:12px;color:#bbb;white-space:nowrap}
.row .grow{flex:1;min-width:0}
input[type=number]{width:66px;background:#111;border:1px solid #444;border-radius:9px;padding:7px;font-size:13px}
input[type=range]{width:100%;accent-color:var(--accent)}
input[type=color]{width:34px;height:30px;padding:0;border:0;background:none}
.presets{display:flex;gap:7px;overflow-x:auto;padding-bottom:2px;scrollbar-width:none}
.presets button{white-space:nowrap;font-size:12px;padding:9px 12px}
.presets button.active{border-color:var(--accent);background:#3a1d29}
.tools{display:flex;gap:7px;overflow-x:auto}
.tools button{font-size:12px;white-space:nowrap;padding:8px 10px}
button:active{transform:scale(.98)}
.note{font-size:10px;color:#777;text-align:center}
#file{display:none}
@media (orientation:landscape){body{gap:6px}.controls{padding:7px;gap:6px}header{height:30px}}
</style>
</head>
<body>
<header>
<div><div class="brand">Gridder</div><small>PHOTO COLLAGE STUDIO</small></div>
<div class="topbar">
<select id="ratio" aria-label="キャンバス比率">
<option value="9:16">Story 9:16</option>
<option value="4:5">Instagram 4:5</option>
<option value="1:1">Square 1:1</option>
<option value="1.91:1">Wide 1.91:1</option>
<option value="16:9">X 16:9</option>
<option value="3:4">X 3:4</option>
</select>
<button class="iconbtn" id="saveTemplate" title="テンプレート保存">▣</button>
<button class="export" id="export">PNG保存</button>
</div>
</header>
<main class="stage" id="stage">
<div class="canvas-wrap"><canvas id="preview" width="1080" height="1920"></canvas></div>
<div class="hint">空白セルをタップして写真を追加 · 写真をタップで選択</div>
</main>
<section class="controls">
<div class="row">
<label>余白</label>
<div class="grow"><input id="gap" type="range" min="0" max="60" value="8"></div>
<input id="gapNum" type="number" min="0" max="200" value="8">
<label>px</label>
<label>色</label>
<input id="bg" type="color" value="#ffffff">
</div>
<div class="presets" id="presets">
<button data-layout="single">1枚</button>
<button data-layout="v2" class="active">縦2分割</button>
<button data-layout="v3">縦3分割</button>
<button data-layout="h2">横2分割</button>
<button data-layout="grid4">2×2</button>
<button data-layout="middle">中央を2分割</button>
<button data-layout="big3">大1＋小3</button>
</div>
<div class="tools">
<button id="add">＋ 写真追加</button>
<button id="rotate">↻ 90°回転</button>
<button id="delete">写真を削除</button>
<button id="clear">全消去</button>
</div>
<div class="note">余白の数値は、写真間とキャンバス外周の4辺すべてに同じpx数で適用されます。</div>
</section>
<input id="file" type="file" accept="image/*" multiple>
<script>
(()=>{
const $=id=>document.getElementById(id),canvas=$('preview'),ctx=canvas.getContext('2d');
const ratios={'9:16':[9,16],'4:5':[4,5],'1:1':[1,1],'1.91:1':[1.91,1],'16:9':[16,9],'3:4':[3,4]};
let ratio='9:16',gap=8,bg='#ffffff',layout='v2',cells=[],selected=-1,pending=-1,drag=null;
const defs={
single:[[0,0,1,1]],
v2:[[0,0,.5,1],[.5,0,.5,1]],
v3:[[0,0,1/3,1],[1/3,0,1/3,1],[2/3,0,1/3,1]],
h2:[[0,0,1,.5],[0,.5,1,.5]],
grid4:[[0,0,.5,.5],[.5,0,.5,.5],[0,.5,.5,.5],[.5,.5,.5,.5]],
middle:[[0,0,1,.34],[0,.34,.5,.33],[.5,.34,.5,.33],[0,.67,1,.33]],
big3:[[0,0,.66,1],[.66,0,.34,1/3],[.66,1/3,.34,1/3],[.66,2/3,.34,1/3]]
};
function makeCells(key){
layout=key;
cells=defs[key].map(r=>({r:[...r],img:null,scale:1,ox:0,oy:0,rot:0}));
selected=-1;draw();
document.querySelectorAll('.presets button').forEach(b=>b.classList.toggle('active',b.dataset.layout===key));
}
function dims(){let [w,h]=ratios[ratio];return w/h}
function fitCanvas(){
let stage=$('stage'),ar=dims(),maxW=stage.clientWidth,maxH=stage.clientHeight;
let w=maxW,h=w/ar;
if(h>maxH){h=maxH;w=h*ar}
canvas.style.width=w+'px';canvas.style.height=h+'px';
}
function draw(){
const [rw,rh]=ratios[ratio];
let W=1080,H=Math.round(1080*rh/rw);
if(H>5000){H=5000;W=Math.round(H*rw/rh)}
canvas.width=W;canvas.height=H;
ctx.fillStyle=bg;ctx.fillRect(0,0,W,H);
const g=gap;
cells.forEach((c,i)=>{
let [x,y,w,h]=c.r;
let x0=g+x*(W-2*g),y0=g+y*(H-2*g),cw=w*(W-2*g),ch=h*(H-2*g);
ctx.save();ctx.beginPath();ctx.rect(x0,y0,cw,ch);ctx.clip();
if(c.img){
let im=c.img,rot=c.rot*Math.PI/180;
ctx.translate(x0+cw/2+c.ox*cw,y0+ch/2+c.oy*ch);ctx.rotate(rot);
let iw=im.naturalWidth,ih=im.naturalHeight;
if(Math.abs(c.rot)%180===90)[iw,ih]=[ih,iw];
let s=Math.max(cw/iw,ch/ih)*c.scale;
ctx.drawImage(im,-iw*s/2,-ih*s/2,iw*s,ih*s);
}else{
ctx.fillStyle='#29292b';ctx.fillRect(x0,y0,cw,ch);
ctx.fillStyle='#777';ctx.font=`bold ${Math.max(24,Math.min(W,H)*.035)}px sans-serif`;
ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText('+',x0+cw/2,y0+ch/2);
}
ctx.restore();
if(i===selected){
ctx.strokeStyle='#ff3b70';ctx.lineWidth=Math.max(3,W/360);
ctx.strokeRect(x0+2,y0+2,cw-4,ch-4);
}
});
fitCanvas();
}
function pos(e){
let b=canvas.getBoundingClientRect();
return{x:(e.clientX-b.left)/b.width*canvas.width,y:(e.clientY-b.top)/b.height*canvas.height};
}
function hit(p){
let W=canvas.width,H=canvas.height,g=gap;
for(let i=cells.length-1;i>=0;i--){
let [x,y,w,h]=cells[i].r;
let a=g+x*(W-2*g),b=g+y*(H-2*g),c=w*(W-2*g),d=h*(H-2*g);
if(p.x>=a&&p.x<=a+c&&p.y>=b&&p.y<=b+d)return i;
}
return -1;
}
canvas.addEventListener('pointerdown',e=>{
let p=pos(e),i=hit(p);if(i<0)return;
selected=i;let c=cells[i];
if(c.img){
drag={id:e.pointerId,x:p.x,y:p.y,ox:c.ox,oy:c.oy,w:c.r[2]*(canvas.width-2*gap),h:c.r[3]*(canvas.height-2*gap)};
canvas.setPointerCapture(e.pointerId);
}
draw();
});
canvas.addEventListener('pointermove',e=>{
if(!drag||drag.id!==e.pointerId)return;
let p=pos(e),c=cells[selected];
c.ox=drag.ox+(p.x-drag.x)/drag.w;
c.oy=drag.oy+(p.y-drag.y)/drag.h;draw();
});
canvas.addEventListener('pointerup',()=>drag=null);
canvas.addEventListener('click',e=>{
if(drag)return;
let i=hit(pos(e));
if(i>=0){selected=i;if(!cells[i].img)openPicker(i);else draw()}
});
function openPicker(i){pending=i;$('file').click()}
$('file').addEventListener('change',e=>{
let files=[...e.target.files];if(!files.length)return;
let start=pending>=0?pending:cells.findIndex(c=>!c.img);
files.forEach((f,n)=>{
let idx=start+n;if(idx>=cells.length)return;
let url=URL.createObjectURL(f),im=new Image();
im.onload=()=>{
cells[idx].img=im;cells[idx].scale=1;cells[idx].ox=0;cells[idx].oy=0;
selected=idx;draw();URL.revokeObjectURL(url);
};
im.src=url;
});
pending=-1;e.target.value='';
});
$('add').onclick=()=>openPicker(selected>=0?selected:Math.max(0,cells.findIndex(c=>!c.img)));
$('rotate').onclick=()=>{
if(selected>=0&&cells[selected].img){cells[selected].rot=(cells[selected].rot+90)%360;draw()}
};
$('delete').onclick=()=>{
if(selected>=0){cells[selected].img=null;cells[selected].scale=1;cells[selected].ox=0;cells[selected].oy=0;draw()}
};
$('clear').onclick=()=>{cells.forEach(c=>c.img=null);selected=-1;draw()};
$('presets').addEventListener('click',e=>{
let b=e.target.closest('button[data-layout]');if(b)makeCells(b.dataset.layout);
});
$('ratio').onchange=e=>{ratio=e.target.value;draw()};
$('gap').oninput=e=>{gap=+e.target.value;$('gapNum').value=gap;draw()};
$('gapNum').onchange=e=>{
gap=Math.max(0,Math.min(200,+e.target.value||0));
$('gap').value=Math.min(60,gap);e.target.value=gap;draw();
};
$('bg').oninput=e=>{bg=e.target.value;draw()};
$('saveTemplate').onclick=()=>{
let data={ratio,gap,bg,layout};
localStorage.setItem('gridder-template',JSON.stringify(data));
alert('テンプレートを保存しました');
};
$('export').onclick=()=>{
let a=document.createElement('a');a.download='Gridder.png';
a.href=canvas.toDataURL('image/png');a.click();
};
window.addEventListener('resize',fitCanvas);
makeCells('v2');
let saved=localStorage.getItem('gridder-template');
if(saved){
try{
let s=JSON.parse(saved);ratio=s.ratio||ratio;gap=s.gap??gap;bg=s.bg||bg;
$('ratio').value=ratio;$('gap').value=Math.min(60,gap);$('gapNum').value=gap;$('bg').value=bg;
makeCells(s.layout||'v2');
}catch{}
}
})();
</script>
</body>
</html>
